# Telegram bot
BOT_TOKEN=123456:replace_me
ADMIN_IDS=123456789

# Public webhook endpoint
WEBHOOK_URL=https://example.com
WEBHOOK_PATH=/webhook/telegram

# Database
POSTGRES_USER=avabot
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=avabot
DATABASE_URL=postgresql+asyncpg://avabot:replace_me@db:5432/avabot

# Admin panel
ADMIN_PANEL_USER=admin
ADMIN_PANEL_PASS=replace_me
ADMIN_PANEL_SECRET=replace_me_with_long_random_string

# AnimeGO parser
SCRAPER_API_KEYS=main-replace_me
ANIMEGO_DIRECT_ENABLED=false
ANIMEGO_DIRECT_TIMEOUT_SECONDS=1.5
ANIMEGO_CACHE_TTL_SECONDS=300

# Mini App
MINIAPP_BOT_URL=https://t.me/YOUR_BOT_USERNAME
MINIAPP_DEV_AUTH_ENABLED=false

# Runtime
LOG_LEVEL=INFO

# Telegram bot
BOT_TOKEN=123456:replace_me
ADMIN_IDS=123456789

# Public webhook endpoint
WEBHOOK_URL=https://example.com
WEBHOOK_PATH=/webhook/telegram

# Database
POSTGRES_USER=avabot
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=avabot
DATABASE_URL=postgresql+asyncpg://avabot:replace_me@db:5432/avabot

## Redis
REDIS_PASSWORD=your_secure_redis_password

# Admin panel
ADMIN_PANEL_USER=admin
ADMIN_PANEL_PASS=replace_me
ADMIN_PANEL_SECRET=replace_me_with_long_random_string

# AnimeGO parser
# Encrypts ScraperAPI keys stored in the database. Changing it makes saved keys unreadable.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SCRAPER_KEYS_SECRET=replace_me_with_long_random_string
# Optional, legacy: NAME-API_KEY,NAME2-API_KEY. Imported into the database only on the first start
# (while the keys table is empty); after that keys are managed in the mini app admin page.
SCRAPER_API_KEYS=
ANIMEGO_DIRECT_ENABLED=false
ANIMEGO_DIRECT_TIMEOUT_SECONDS=1.5
ANIMEGO_CACHE_TTL_SECONDS=300
SCRAPER_API_TIMEOUT_SECONDS=70

# Mini App
MINIAPP_BOT_URL=https://t.me/YOUR_BOT_USERNAME
# Public HTTPS address of the mini app (frontend): "Open app" buttons and the chat menu button
MINIAPP_URL=https://miniapp.example.com
MINIAPP_DEV_AUTH_ENABLED=false

# Runtime
LOG_LEVEL=INFO
